# =============================================================================
# BuildWise AI — Backend Production & Local Environment Configuration (.env.example)
# Platform: Render (Production) / Localhost (Development)
# Copy this file to .env for local development or enter values in Render Dashboard.
# =============================================================================

# Application Environment: development | production
# On Render: set to "production"
ENVIRONMENT=production

# Server Host Interface & Port
# Render assigns PORT dynamically. Host MUST be 0.0.0.0 in production to accept traffic.
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (Frontend URLs permitted to make cross-origin requests)
# On Render: Enter your Vercel URL without a trailing slash (e.g. https://your-app.vercel.app)
# Comma-separate multiple origins if using preview deployments.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Optional: CORS Origin Regular Expression for Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Cookie Security & Cross-Site Settings
# In production across Vercel (*.vercel.app) and Render (*.onrender.com), cookies
# MUST use COOKIE_SAMESITE=none and COOKIE_SECURE=true to be delivered cross-site.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Database Configuration: Supabase PostgreSQL (Production) vs SQLite (Local)
# On Render: Set to your Supabase Transaction/Session Pooler connection string:
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# IMPORTANT: Use the pooler URL (pooler.supabase.com on port 6543 or 5432) on Render Free Tier
# because Render free instances do not support direct IPv6-only connections.
# Leave blank or unset to fallback to local SQLite database (data/buildwise.db).
DATABASE_URL=
DATABASE_PATH=data/buildwise.db

# Authentication Secrets & Base URL (Better Auth)
# Generate a secure 32+ character key with: openssl rand -base64 32
# SENSITIVE: Never commit the actual key to git!
BETTER_AUTH_SECRET=generate-a-secure-32-char-random-secret-key-here
# Production frontend URL that users visit (e.g. https://your-app.vercel.app)
BETTER_AUTH_URL=https://your-app.vercel.app

# BYOK AI Credential Encryption Key (AES-256-GCM encryption at rest for stored API keys)
# Generate with: openssl rand -base64 32
# SENSITIVE: Never commit the actual key to git!
AI_CREDENTIAL_ENCRYPTION_KEY=generate-a-secure-32-char-encryption-key-here

# Default AI Engine Provider
# Options: mock | groq | gemini | openai | anthropic | ollama
# System operates 100% deterministically with "mock" without any paid external keys.
DEFAULT_AI_PROVIDER=mock

# Brevo Transactional Email Service (Optional: for Password Reset & Verification OTPs)
# Obtain from: https://app.brevo.com/settings/keys/api
# BREVO_SENDER_EMAIL must match a verified sender email in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BuildWise AI

# Optional Hosted AI Provider Keys (for server-wide default AI fallback)
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free Google Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Local Ollama Host URL (only used if running Ollama locally)
OLLAMA_BASE_URL=http://localhost:11434
