# =============================================================================
# BuildWise AI — Backend Environment Configuration
# =============================================================================

# Application Environment: development | production | staging
ENVIRONMENT=development

# Server Network Interface and Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated origins allowed to make browser requests)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Explanation & Placement Provider
# Supported options: mock | groq | gemini | ollama
# System operates 100% deterministically with "mock" without any external API keys
DEFAULT_AI_PROVIDER=mock

# SQLite Database Path (shared with Better Auth)
DATABASE_PATH=data/buildwise.db

# Authentication & Session Verification
# Sessions are validated against SQLite session and user tables
# Secret must match Better Auth server BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=buildwise-production-master-secret-key-change-in-prod-min-32-chars
BETTER_AUTH_URL=http://localhost:5173

# AI BYOK Credential Encryption Key (AES-256-GCM encryption at rest)
# Generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=buildwise-production-ai-credentials-key-min-32-chars

# Brevo Transactional Email Service (Password Reset OTP Delivery)
# When set, emails are dispatched via https://api.brevo.com/v3/smtp/email
# Note: BREVO_SENDER_EMAIL must match a verified sender in your Brevo account (e.g. your registered email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BuildWise AI

# Optional API Keys (leave blank to run purely with zero-paid offline mock providers)
# Get Groq key: https://console.groq.com/
GROQ_API_KEY=
# Get Gemini key: https://aistudio.google.com/
GEMINI_API_KEY=

# Local Ollama Host URL (used when AI provider is set to "ollama")
OLLAMA_BASE_URL=http://localhost:11434
