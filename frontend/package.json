{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "audit:ui": "node scripts/audit.cjs",
    "lint:tokens": "node scripts/lint_tokens.cjs",
    "lint:emoji": "node scripts/lint_emoji.cjs",
    "check:contrast": "node scripts/check_contrast.cjs",
    "test:design": "node scripts/test_design_system.cjs",
    "test:map-controls": "node --experimental-strip-types scripts/test_map_controls_offset.cjs",
    "test:trace-ui": "node scripts/e2e_trace_ui.cjs",
    "test:e2e": "node scripts/e2e_full_funnel.cjs",
    "test:report-surface": "node scripts/test_report_surface.cjs",
    "test:validation-guards": "node scripts/test_validation_guards.cjs",
    "test:selection-policy": "node scripts/e2e_selection_policy.cjs",
    "test:ui-closure": "node scripts/e2e_ui_closure.cjs",
    "gates": "npm run build && npm run test:report-surface && npm run test:validation-guards",
    "gates:browser": "node scripts/e2e_selection_policy.cjs && node scripts/e2e_full_funnel.cjs && node scripts/e2e_ui_closure.cjs",
    "assert:bundle": "node scripts/assert_bundle_split.cjs",
    "lint:css": "node scripts/css_orphans.cjs",
    "lint:material": "node scripts/lint_material.cjs",
    "test:interaction": "node scripts/test_interaction_primitives.cjs",
    "probe:interaction": "node scripts/interaction_probe.cjs",
    "audit:landing": "node scripts/landing_audit.cjs"
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "lenis": "^1.3.26",
    "maplibre-gl": "^6.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "web-vitals": "^6.2.3"
  }
}
