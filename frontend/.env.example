# =============================================================================
# BuildWise AI — Frontend Production & Local Environment Configuration (.env.example)
# Platform: Vercel (Production) / Localhost (Development)
# =============================================================================

# Backend API Service URL
# On Local Development: http://localhost:8000
# On Vercel Hobby Deployment: Set this in the Vercel Project Dashboard (Settings -> Environment Variables)
# to your deployed Render backend service URL without a trailing slash:
# Example: https://buildwise-api.onrender.com
# Note: In Vite, variables exposed to client-side code MUST start with the VITE_ prefix.
VITE_API_URL=https://your-backend-api.onrender.com
